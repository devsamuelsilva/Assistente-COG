# Chave da API do GPT. Entra na redação da resposta, no chat ONS e na transcrição única dos quadros. A busca é local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Modelo barato das etapas de apoio (hoje: reescrever a pergunta com a conversa).
AUX_MODEL=gpt-4.1-mini
# v2: três estados (coberto, parcial, ausente), citação por número do trecho e saída estruturada.
# v1: prompt anterior. Rode a prova nas duas para comparar.
PROMPT_VERSAO=v2
# llm ou off. Off volta a somar as perguntas anteriores do chat na busca.
REESCREVER=llm
# Deixe vazio para usar https://api.openai.com/v1
OPENAI_BASE_URL=

# Token de segurança do outgoing webhook do Teams (base64).
TEAMS_OUTGOING_HMAC_SECRET=
# URL do incoming webhook ou do fluxo do mesmo canal.
TEAMS_INCOMING_WEBHOOK_URL=
# adaptive | messagecard | texto
TEAMS_POST_FORMAT=adaptive

ACERVO_DIR=acervo
DATA_DIR=data
HOST=127.0.0.1
PORT=8080
# Modelo local de embeddings. Trocar exige rodar python -m app indexar de novo.
EMBED_MODEL=google/embeddinggemma-300m
TOP_K=6
# trechos | secao | documento
MODO_CONTEXTO=trechos
# Reordenador local. Vazio desliga. Sugerido: jinaai/jina-reranker-v2-base-multilingual
RERANKER_MODEL=
# Quantos candidatos o reordenador lê
CANDIDATOS=12

# Chat ONS: servidor MCP público dos dados abertos do ONS (TIAGO Dados Abertos).
ONS_MCP_URL=https://mcp.dados.tiago.ons.org.br/
# Quantas rodadas de ferramentas o GPT pode fazer antes de responder
ONS_MAX_PASSOS=6
# Agente do cadastro do ONS que é "a empresa" no chat. As usinas dele entram no prompt. Vazio desliga.
ONS_AGENTE=ENERGIMP
