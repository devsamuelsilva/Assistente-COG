# Chave da API do GPT. Só entra na redação da resposta. A indexação é local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Deixe vazio para usar https://api.openai.com/v1
OPENAI_BASE_URL=

# Token de segurança do outgoing webhook do Teams (base64).
TEAMS_OUTGOING_HMAC_SECRET=
# URL do incoming webhook ou do fluxo do mesmo canal.
TEAMS_INCOMING_WEBHOOK_URL=
# adaptive | messagecard | texto
TEAMS_POST_FORMAT=adaptive

ACERVO_DIR=acervo
DATA_DIR=data
HOST=127.0.0.1
PORT=8080
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=6
